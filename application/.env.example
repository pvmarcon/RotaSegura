RABBITMQ_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=smart_cities_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SIMULATE_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-random-long-secret
SESSION_MAX_AGE_SECONDS=14400
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:8000
GRAFANA_URL=http://127.0.0.1:3000

# Controla quantas requisições são enviadas em paralelo
# e o limite máximo seguro para evitar saturar o ambiente.
SIMULATION_MAX_CONCURRENCY=25
SIMULATION_HARD_CAP=5000
SIMULATION_MIN_INTERVAL_S=1
SIMULATION_MAX_INTERVAL_S=3

# Se a app rodar dentro do Docker Compose, use:
# DOCKER_CONTAINER=1
# RABBITMQ_HOST=rabbitmq
# REDIS_HOST=redis
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# APP_BASE_URL=http://localhost:8000
# GRAFANA_URL=http://localhost:3000